# =============================================================================
# CineWatch AI - Environment Variables Template
# Copy this file to .env.local and populate with your credentials
# =============================================================================

# The Movie Database (TMDB) API Key (v3 auth)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase Authentication & Realtime Database
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI & LLM Providers (for AI Chat Assistant & Semantic Vector Search)
# Google Gemini API key (used for vector embeddings and chat assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere API Key (optional fallback for AI chat assistant)
COHERE_API_KEY=your_cohere_api_key_here

# FastAPI Python Microservice URL
# Default local microservice endpoint for vector search
PYTHON_BACKEND_URL=http://127.0.0.1:8000/search

# ServiceNow Incident Ticketing Integration (Optional / Enterprise)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_servicenow_password
